{
  "name": "tactica-server",
  "version": "1.0.0",
  "description": "Tactica game server with WebSocket support",
  "main": "dist/server/src/index.js",
  "scripts": {
    "dev": "node ../scripts/build-engine.js && ts-node-dev --respawn src/index.ts",
    "build": "cd .. && npm install && cd server && node ../scripts/build-engine.js && tsc",
    "start": "node dist/server/src/index.js"
  },
  "keywords": [
    "game",
    "websocket",
    "server"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@supabase/supabase-js": "^2.45.4",
    "dotenv": "^16.4.5",
    "cors": "^2.8.5",
    "express": "^5.2.1",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^22.10.1",
    "@types/ws": "^8.5.13",
    "esbuild": "^0.27.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.7.2"
  }
}
